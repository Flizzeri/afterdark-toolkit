{
        "$schema": "https://turbo.build/schema.json",
        "tasks": {
                "build": {
                        "dependsOn": ["^build"],
                        "outputs": ["dist/**"]
                },
                "test": {
                        "dependsOn": ["build"],
                        "cache": true
                },
                "check": {
                        "dependsOn": ["build"],
                        "cache": true
                },
                "coverage": {
                        "dependsOn": ["build"],
                        "cache": true,
                        "outputs": ["coverage/**"]
                },
                "lint": {
                        "cache": true
                },
                "clean": {
                        "cache": false
                },
                "dev": {
                        "cache": false,
                        "persistent": true
                }
        }
}
