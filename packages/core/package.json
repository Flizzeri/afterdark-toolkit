{
        "name": "@adtk/core",
        "version": "0.1.0",
        "description": "Core IR types and extraction logic for Afterdark Toolkit",
        "type": "module",
        "exports": {
                ".": {
                        "types": "./dist/index.d.ts",
                        "default": "./dist/index.js"
                }
        },
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "files": [
                "dist",
                "README.md"
        ],
        "scripts": {
                "build": "tsc -p tsconfig.json",
                "dev": "tsc -p tsconfig.json --watch",
                "test": "vitest run",
                "test:watch": "vitest",
                "coverage": "vitest run --coverage",
                "check": "tsc --noEmit",
                "clean": "rimraf dist",
                "lint": "eslint src --ext .ts"
        },
        "dependencies": {
                "@adtk/shared": "workspace:*"
        },
        "devDependencies": {
                "typescript": "catalog:",
                "vitest": "catalog:",
                "@vitest/coverage-v8": "catalog:",
                "rimraf": "catalog:",
                "@eslint/js": "catalog:",
                "@typescript-eslint/eslint-plugin": "catalog:",
                "@typescript-eslint/parser": "catalog:",
                "eslint": "catalog:",
                "eslint-config-prettier": "catalog:",
                "eslint-plugin-import": "catalog:",
                "eslint-plugin-import-x": "catalog:",
                "eslint-plugin-jsdoc": "catalog:"
        },
        "publishConfig": {
                "access": "public"
        }
}
