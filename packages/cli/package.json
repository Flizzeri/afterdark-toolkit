{
        "name": "@adtk/cli",
        "version": "0.1.0",
        "description": "Command-line interface for Afterdark Toolkit",
        "type": "module",
        "bin": {
                "adtk": "./dist/cli.js"
        },
        "files": [
                "dist",
                "README.md"
        ],
        "scripts": {
                "build": "tsc -p tsconfig.json",
                "dev": "tsc -p tsconfig.json --watch",
                "test": "vitest run",
                "test:watch": "vitest",
                "check": "tsc --noEmit",
                "clean": "rimraf dist",
                "lint": "eslint src --ext .ts"
        },
        "dependencies": {
                "@adtk/compiler": "workspace:*",
                "@adtk/shared": "workspace:*",
                "commander": "^12.0.0",
                "picocolors": "^1.0.0"
        },
        "devDependencies": {},
        "publishConfig": {
                "access": "public"
        }
}
