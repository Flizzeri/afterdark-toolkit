{
        "name": "@adtk/shared",
        "version": "0.1.0",
        "description": "Shared types and utilities for Afterdark Toolkit",
        "type": "module",
        "exports": {
                ".": {
                        "types": "./dist/index.d.ts",
                        "default": "./dist/index.js"
                }
        },
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "files": [
                "dist",
                "README.md"
        ],
        "scripts": {
                "build": "tsc -p tsconfig.json",
                "dev": "tsc -p tsconfig.json --watch",
                "test": "vitest run",
                "test:watch": "vitest",
                "coverage": "vitest run --coverage",
                "check": "tsc --noEmit",
                "clean": "rimraf dist",
                "lint": "eslint src --ext .ts"
        },
        "dependencies": {},
        "devDependencies": {},
        "publishConfig": {
                "access": "public"
        }
}
