{
        "name": "@adtk/program",
        "version": "0.1.0",
        "description": "TypeScript compiler wrapper for Afterdark Toolkit",
        "type": "module",
        "exports": {
                ".": {
                        "types": "./dist/index.d.ts",
                        "default": "./dist/index.js"
                }
        },
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "files": [
                "dist",
                "README.md"
        ],
        "scripts": {
                "build": "tsc -p tsconfig.build.json",
                "dev": "tsc -p tsconfig.build.json --watch",
                "test": "vitest run",
                "test:watch": "vitest",
                "coverage": "vitest run --coverage",
                "check": "tsc --noEmit",
                "clean": "rimraf dist",
                "lint": "eslint src --ext .ts"
        },
        "dependencies": {
                "@adtk/shared": "workspace:*",
                "typescript": "^5.9.3"
        },
        "devDependencies": {},
        "publishConfig": {
                "access": "public"
        }
}
