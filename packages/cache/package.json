{
        "name": "@adtk/cache",
        "version": "0.1.0",
        "description": "High-performance Rust-based caching layer for Afterdark Toolkit",
        "type": "module",
        "exports": {
                ".": {
                        "types": "./dist/index.d.ts",
                        "default": "./dist/index.js"
                }
        },
        "main": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "files": [
                "dist",
                "*.node",
                "README.md"
        ],
        "scripts": {
                "build": "napi build --platform --release",
                "build:debug": "napi build --platform",
                "dev": "napi build --platform --watch",
                "test": "vitest run",
                "test:watch": "vitest",
                "coverage": "vitest run --coverage",
                "check": "tsc --noEmit",
                "clean": "rimraf dist *.node",
                "lint": "eslint src --ext .ts"
        },
        "dependencies": {
                "@adtk/shared": "workspace:*"
        },
        "devDependencies": {
                "@napi-rs/cli": "^3.0.0"
        },
        "napi": {
                "name": "adtk-cache",
                "triples": {
                        "defaults": true,
                        "additional": [
                                "x86_64-unknown-linux-musl",
                                "aarch64-unknown-linux-gnu",
                                "aarch64-apple-darwin"
                        ]
                }
        },
        "publishConfig": {
                "access": "public"
        }
}
